# Galaxie: option names and descriptions (written by the option table).
screen.LIGHTING=Lighting
screen.SKY=Sky and clouds
screen.WEATHER=Rain and wind
screen.WATER=Water
screen.PICTURE=Exposure and tone
screen.CAMERA=Camera effects
option.SHADOWS=Shadows
option.WATER_MIRROR=Water mirror
option.WATER_MIRROR.comment=The world mirrored in the water. Off: the water reflects the sky colour only.
option.COLORED_LIGHT=Coloured light
option.COLORED_LIGHT.comment=Lava, soul torches and other sources colour what they light.
option.BLOCK_LIGHT_HUE=Block light colour
option.BLOCK_LIGHT_HUE.comment=The colour of block light away from a light source's own faces. Torch: what lights most caves. Lava: the WGSL pack's colour past its light grid.
value.BLOCK_LIGHT_HUE.0=Lava
value.BLOCK_LIGHT_HUE.1=Torch
value.BLOCK_LIGHT_HUE.2=Warm white
option.RAY_STRENGTH=Light shafts
option.RAY_STRENGTH.comment=How strongly sunlight glows in the air and through gaps.
option.BLOOM_STRENGTH=Bloom
option.FOG_AMOUNT=Haze
option.FOG_AMOUNT.comment=Haze over far terrain. Jungles are humid, deserts dusty, cold biomes clear and blue.
option.VOLUMETRIC_CLOUDS=Volumetric clouds
option.VOLUMETRIC_CLOUDS.comment=The pack's drifting clouds. Off: a clear sky, with no cloud shadows or shafts between clouds.
option.CLOUD_AMOUNT=Clouds
option.CLOUD_QUALITY=Cloud quality
option.CLOUD_QUALITY.comment=How finely the clouds are traced. High is smoother and costs more.
value.CLOUD_QUALITY.0=Low
value.CLOUD_QUALITY.1=Medium
value.CLOUD_QUALITY.2=High
option.WETNESS_AMOUNT=Wet ground
option.WETNESS_AMOUNT.comment=Rain darkens exposed ground and fills reflecting puddles. Shallow puddles dry first.
option.PUDDLE_DRYING=Puddle drying time
option.PUDDLE_DRYING.comment=Seconds for a fully soaked surface to dry after rain. Shader reloads clear the rainwater.
option.STORM_FLASHES=Lightning flashes
option.STORM_FLASHES.comment=Distant sheet lightning during thunderstorms. 0 is off. Independent of vanilla strikes and thunder.
option.WIND_STRENGTH=Wind
option.WIND_STRENGTH.comment=How far leaves, grass and flowers move. Rain and thunder add to it.
option.WAVE_HEIGHT=Wave height
option.WAVE_SPEED=Wave speed
option.GALAXY_BRIGHTNESS=Nebula brightness
option.STAR_DENSITY=Star density
option.AURORA=Aurora
option.AURORA.comment=Northern lights, now and then, at night in cold biomes only.
option.DAY_BLUE=Day blue
option.DAY_BLUE.comment=How deep the blue of the day sky is.
option.EXPOSURE=Exposure
option.AUTO_EXPOSURE=Auto exposure
option.AUTO_EXPOSURE.comment=The picture brightens in the dark and settles outside, like an eye.
option.SATURATION=Saturation
option.FXAA=Smooth edges
option.DEPTH_OF_FIELD=Depth of field
option.DEPTH_OF_FIELD.comment=Blurs what is nearer or farther than the thing in the middle of the screen. 0 is off.
option.MOTION_BLUR=Motion blur
option.CHROMATIC_ABERRATION=Chromatic aberration
option.VIGNETTE=Vignette
suffix.PUDDLE_DRYING= s
